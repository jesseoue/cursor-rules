## TypeScript Integration

### Environment Interface
```typescript
export interface Env {
  DB: D1Database
  ANALYTICS_DB: D1Database
}
```

### Basic Queries
```typescript
export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const { DB } = env

    // SELECT query
    const { results } = await DB.prepare(
      'SELECT * FROM users WHERE email = ?'
    )
      .bind('user@example.com')
      .all()

    return Response.json(results)
  },
}
```

### CRUD Operations
```typescript
// CREATE
async function createUser(db: D1Database, email: string, name: string) {
  const result = await db
    .prepare('INSERT INTO users (email, name) VALUES (?, ?) RETURNING *')
    .bind(email, name)
    .first()

  return result
}

// READ
async function getUser(db: D1Database, userId: number) {
  const user = await db
    .prepare('SELECT * FROM users WHERE id = ?')
    .bind(userId)
    .first()

  return user
}

// UPDATE
async function updateUser(db: D1Database, userId: number, name: string) {
  const result = await db
    .prepare('UPDATE users SET name = ? WHERE id = ? RETURNING *')
    .bind(name, userId)
    .first()

  return result
}

// DELETE
async function deleteUser(db: D1Database, userId: number) {
  await db.prepare('DELETE FROM users WHERE id = ?').bind(userId).run()
}
```

### Batch Operations
```typescript
// Batch inserts (more efficient)
async function batchCreateUsers(
  db: D1Database,
  users: Array<{ email: string; name: string }>
) {
  const statements = users.map((user) =>
    db.prepare('INSERT INTO users (email, name) VALUES (?, ?)').bind(user.email, user.name)
  )

  // Execute all statements in a single request
  const results = await db.batch(statements)

  return results
}
```

### Transactions
```typescript
// Atomic transactions
async function transferCredits(
  db: D1Database,
  fromUserId: number,
  toUserId: number,
  amount: number
) {
  const statements = [
    db.prepare('UPDATE users SET credits = credits - ? WHERE id = ?').bind(amount, fromUserId),
    db.prepare('UPDATE users SET credits = credits + ? WHERE id = ?').bind(amount, toUserId),
    db
      .prepare('INSERT INTO transactions (from_user_id, to_user_id, amount) VALUES (?, ?, ?)')
      .bind(fromUserId, toUserId, amount),
  ]

  // All or nothing
  const results = await db.batch(statements)

  return results
}
```

## Advanced Queries

### JSON Queries
```typescript
// Query JSON fields
async function getProductsByColor(db: D1Database, color: string) {
  const { results } = await db
    .prepare(
      `SELECT * FROM products
       WHERE json_extract(metadata, '$.color') = ?`
    )
    .bind(color)
    .all()

  return results
}

// Query JSON arrays
async function getProductsByTag(db: D1Database, tag: string) {
  const { results } = await db
    .prepare(
      `SELECT * FROM products
       WHERE EXISTS (
         SELECT 1 FROM json_each(tags)
         WHERE value = ?
       )`
    )
    .bind(tag)
    .all()

  return results
}
```

### Full-Text Search
```sql
-- Create FTS table
CREATE VIRTUAL TABLE posts_fts USING fts5(
  title,
  content,
  content=posts,
  content_rowid=id
);

-- Populate FTS table
INSERT INTO posts_fts (rowid, title, content)
SELECT id, title, content FROM posts;
```

```typescript
// Full-text search
async function searchPosts(db: D1Database, query: string) {
  const { results } = await db
    .prepare(
      `SELECT posts.* FROM posts
       JOIN posts_fts ON posts.id = posts_fts.rowid
       WHERE posts_fts MATCH ?
       ORDER BY rank`
    )
    .bind(query)
    .all()

  return results
}
```

### Pagination
```typescript
async function getPaginatedUsers(db: D1Database, page: number, pageSize: number = 20) {
  const offset = (page - 1) * pageSize

  const { results } = await db
    .prepare('SELECT * FROM users ORDER BY created_at DESC LIMIT ? OFFSET ?')
    .bind(pageSize, offset)
    .all()

  const { total } = (await db.prepare('SELECT COUNT(*) as total FROM users').first()) as {
    total: number
  }

  return {
    results,
    page,
    pageSize,
    totalPages: Math.ceil(total / pageSize),
    total,
  }
}
```

## Read Replication (2025 - Beta)

### Session-Based Consistency
```typescript
// Create session for sequential consistency
export default {
  async fetch(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {
    const { DB } = env

    // All queries in this session have sequential consistency
    // Reads will route to nearest replica
    const user = await DB.prepare('SELECT * FROM users WHERE id = ?').bind(123).first()

    // Subsequent queries see previous writes
    const posts = await DB.prepare('SELECT * FROM posts WHERE user_id = ?').bind(123).all()

    return Response.json({ user, posts: posts.results })
  },
}
```

### Read from Replicas
```typescript
// Read operations automatically routed to nearest replica
async function getAnalytics(db: D1Database, startDate: number, endDate: number) {
  // This read query will be served from the nearest replica
  const { results } = await db
    .prepare(
      `SELECT
        date(created_at, 'unixepoch') as date,
        COUNT(*) as count
       FROM events
       WHERE created_at BETWEEN ? AND ?
       GROUP BY date`
    )
    .bind(startDate, endDate)
    .all()

  return results
}
```

## Time Travel (Disaster Recovery)

### Restore from Point in Time
```bash
# Restore database to specific point in time (last 30 days)
wrangler d1 time-travel restore my-database --before="2025-10-15T10:30:00Z"

# Create backup at specific point
wrangler d1 time-travel export my-database --timestamp="2025-10-15T10:30:00Z" --output=backup.sql
```

