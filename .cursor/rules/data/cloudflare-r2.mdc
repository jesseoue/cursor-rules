# Cloudflare R2 Object Storage Rules (2025)

## What is Cloudflare R2

R2 is Cloudflare's S3-compatible object storage with zero egress fees, automatic region selection, and native Workers integration across 330+ locations.

### Key Features
- **Zero Egress Fees**: No charges for data transfer out
- **S3 Compatible**: Full S3 API compatibility
- **Auto Region Selection**: Optimized performance based on upload location
- **Object Lifecycles**: Automated data management rules
- **Workers Integration**: Direct access from Workers
- **Super Slurper**: Easy migration from S3/GCS
- **Public Buckets**: Serve static assets via R2.dev domain
- **Presigned URLs**: Temporary access to private objects
- **Multipart Uploads**: Efficient large file uploads

## Installation & Setup

### Create R2 Bucket
```bash
# Install Wrangler
npm install -g wrangler

# Create bucket
wrangler r2 bucket create my-bucket

# List buckets
wrangler r2 bucket list

# Delete bucket
wrangler r2 bucket delete my-bucket
```

### Configure wrangler.toml
```toml
name = "my-worker"
main = "src/index.ts"
compatibility_date = "2025-01-01"

[[r2_buckets]]
binding = "MY_BUCKET"
bucket_name = "my-bucket"

# Multiple buckets
[[r2_buckets]]
binding = "IMAGES"
bucket_name = "user-images"

[[r2_buckets]]
binding = "VIDEOS"
bucket_name = "user-videos"
```

## Basic Operations

### TypeScript Environment
```typescript
export interface Env {
  MY_BUCKET: R2Bucket
  IMAGES: R2Bucket
  VIDEOS: R2Bucket
}
```

### Upload Object
```typescript
export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const { MY_BUCKET } = env

    // Upload text
    await MY_BUCKET.put('hello.txt', 'Hello, World!')

    // Upload JSON
    await MY_BUCKET.put('config.json', JSON.stringify({ version: '1.0' }), {
      httpMetadata: {
        contentType: 'application/json',
      },
    })

    // Upload with custom metadata
    await MY_BUCKET.put('document.pdf', pdfData, {
      httpMetadata: {
        contentType: 'application/pdf',
        contentDisposition: 'attachment; filename="document.pdf"',
        cacheControl: 'public, max-age=31536000',
      },
      customMetadata: {
        uploadedBy: 'user123',
        category: 'documents',
      },
    })

    return new Response('Uploaded successfully')
  },
}
```

### Get Object
```typescript
async function getObject(bucket: R2Bucket, key: string): Promise<Response> {
  const object = await bucket.get(key)

  if (object === null) {
    return new Response('Object not found', { status: 404 })
  }

  const headers = new Headers()
  object.writeHttpMetadata(headers)
  headers.set('etag', object.httpEtag)

  return new Response(object.body, { headers })
}
```

### Delete Object
```typescript
async function deleteObject(bucket: R2Bucket, key: string) {
  await bucket.delete(key)
}

// Delete multiple objects
async function deleteMultiple(bucket: R2Bucket, keys: string[]) {
  await bucket.delete(keys)
}
```

### List Objects
```typescript
async function listObjects(bucket: R2Bucket, prefix?: string) {
  const listed = await bucket.list({
    prefix: prefix,
    limit: 1000,
  })

  return listed.objects.map((obj) => ({
    key: obj.key,
    size: obj.size,
    uploaded: obj.uploaded,
    etag: obj.etag,
  }))
}

// Paginated listing
async function listAllObjects(bucket: R2Bucket) {
  const objects: R2Object[] = []
  let cursor: string | undefined

  do {
    const listed = await bucket.list({
      cursor,
      limit: 1000,
    })

    objects.push(...listed.objects)
    cursor = listed.truncated ? listed.cursor : undefined
  } while (cursor)

  return objects
}
```

## File Upload Handler

### Handle FormData Upload
```typescript
export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    if (request.method !== 'POST') {
      return new Response('Method not allowed', { status: 405 })
    }

    const formData = await request.formData()
    const file = formData.get('file') as File

    if (!file) {
      return Response.json({ error: 'No file provided' }, { status: 400 })
    }

    // Generate unique key
    const key = `uploads/${crypto.randomUUID()}/${file.name}`

    // Upload to R2
    await env.MY_BUCKET.put(key, file.stream(), {
      httpMetadata: {
        contentType: file.type,
      },
      customMetadata: {
        originalName: file.name,
        uploadedAt: new Date().toISOString(),
      },
    })

    return Response.json({
      success: true,
      key,
      size: file.size,
      type: file.type,
    })
  },
}
```

### Image Upload with Validation
```typescript
const ALLOWED_IMAGE_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/gif']
const MAX_FILE_SIZE = 5 * 1024 * 1024 // 5MB

async function uploadImage(bucket: R2Bucket, file: File, userId: string) {
  // Validate file type
  if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {
    throw new Error('Invalid file type')
  }

  // Validate file size
  if (file.size > MAX_FILE_SIZE) {
    throw new Error('File too large')
  }

  const key = `images/${userId}/${crypto.randomUUID()}.${file.type.split('/')[1]}`

  await bucket.put(key, file.stream(), {
    httpMetadata: {
      contentType: file.type,
      cacheControl: 'public, max-age=31536000, immutable',
    },
    customMetadata: {
      userId,
      uploadedAt: new Date().toISOString(),
      originalName: file.name,
    },
  })

  return key
}
```

## Multipart Uploads (Large Files)

### Upload Large File
```typescript
async function uploadLargeFile(bucket: R2Bucket, file: File, key: string) {
  const CHUNK_SIZE = 5 * 1024 * 1024 // 5MB chunks

  // Start multipart upload
  const multipartUpload = await bucket.createMultipartUpload(key, {
    httpMetadata: {
      contentType: file.type,
    },
  })

  try {
    const uploadedParts: R2UploadedPart[] = []
    const totalChunks = Math.ceil(file.size / CHUNK_SIZE)

    for (let i = 0; i < totalChunks; i++) {
      const start = i * CHUNK_SIZE
      const end = Math.min(start + CHUNK_SIZE, file.size)
      const chunk = file.slice(start, end)

      const uploadedPart = await multipartUpload.uploadPart(i + 1, chunk.stream())
      uploadedParts.push(uploadedPart)
    }

    // Complete upload
    const object = await multipartUpload.complete(uploadedParts)

    return object
  } catch (error) {
    // Abort on error
    await multipartUpload.abort()
    throw error
  }
}
```

## Presigned URLs

### Generate Presigned URL (via S3 API)
```typescript
import { S3Client, PutObjectCommand, GetObjectCommand } from '@aws-sdk/client-s3'
import { getSignedUrl } from '@aws-sdk/s3-request-presigner'

async function generatePresignedUploadUrl(
  accountId: string,
  accessKeyId: string,
  secretAccessKey: string,
  bucket: string,
  key: string
) {
  const s3Client = new S3Client({
    region: 'auto',
    endpoint: `https://${accountId}.r2.cloudflarestorage.com`,
    credentials: {
      accessKeyId,
      secretAccessKey,
    },
  })

  const command = new PutObjectCommand({
    Bucket: bucket,
    Key: key,
  })

  // URL valid for 1 hour
  const url = await getSignedUrl(s3Client, command, { expiresIn: 3600 })

  return url
}

async function generatePresignedDownloadUrl(
  accountId: string,
  accessKeyId: string,
  secretAccessKey: string,
  bucket: string,
  key: string
) {
  const s3Client = new S3Client({
    region: 'auto',
    endpoint: `https://${accountId}.r2.cloudflarestorage.com`,
    credentials: {
      accessKeyId,
      secretAccessKey,
    },
  })

  const command = new GetObjectCommand({
    Bucket: bucket,
    Key: key,
  })

  const url = await getSignedUrl(s3Client, command, { expiresIn: 3600 })

  return url
}
```

