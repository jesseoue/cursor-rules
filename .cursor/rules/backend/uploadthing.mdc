### Custom Upload with useUploadThing
```typescript
"use client"

import { useUploadThing } from "@/utils/uploadthing"
import { useState } from "react"

export function CustomUploader() {
  const [files, setFiles] = useState<File[]>([])

  const { startUpload, isUploading, permittedFileInfo } = useUploadThing(
    "imageUploader",
    {
      onClientUploadComplete: (res) => {
        console.log("uploaded successfully!", res)
      },
      onUploadError: (error) => {
        console.error("error occurred while uploading", error)
      },
      onUploadBegin: (name) => {
        console.log("upload has begun for", name)
      },
    }
  )

  return (
    <div>
      <input
        type="file"
        multiple
        onChange={(e) => {
          const files = Array.from(e.target.files || [])
          setFiles(files)
        }}
      />

      <button
        onClick={() => startUpload(files)}
        disabled={!files.length || isUploading}
      >
        {isUploading ? "Uploading..." : "Upload"}
      </button>

      {permittedFileInfo && (
        <div>
          Max size: {permittedFileInfo.config.image?.maxFileSize}
        </div>
      )}
    </div>
  )
}
```

## Advanced Patterns

### With Progress Tracking
```typescript
"use client"

import { useUploadThing } from "@/utils/uploadthing"
import { useState } from "react"

export function ProgressUploader() {
  const [progress, setProgress] = useState(0)

  const { startUpload, isUploading } = useUploadThing("imageUploader", {
    onUploadProgress: (p) => {
      setProgress(p)
    },
  })

  return (
    <div>
      {isUploading && (
        <div className="w-full bg-gray-200 rounded">
          <div
            className="bg-blue-600 h-2 rounded"
            style={{ width: `${progress}%` }}
          />
        </div>
      )}
    </div>
  )
}
```

### Server-Side File Deletion
```typescript
// app/actions/delete-file.ts
"use server"

import { UTApi } from "uploadthing/server"

const utapi = new UTApi()

export async function deleteFile(fileKey: string) {
  await utapi.deleteFiles(fileKey)

  // Also delete from database
  await db.image.delete({
    where: { url: { contains: fileKey } },
  })

  return { success: true }
}
```

## Best Practices

1. **Validate files** - Use maxFileSize and maxFileCount
2. **Authenticate uploads** - Implement middleware auth checks
3. **Handle errors** - Provide user feedback on failures
4. **Show progress** - Use onUploadProgress for UX
5. **Clean up files** - Delete unused files from storage
6. **Save metadata** - Store file info in database
7. **Type safety** - Use TypeScript for router and client
8. **Optimize images** - UploadThing auto-optimizes
9. **Rate limiting** - Implement upload rate limits
10. **File validation** - Check file types in middleware
