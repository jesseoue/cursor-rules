## SQLite Storage (GA - 2025)

### Using SQL Storage API
```typescript
export class UserSession implements DurableObject {
  private sql: SqlStorage

  constructor(private state: DurableObjectState, private env: Env) {
    this.sql = this.state.storage.sql

    // Initialize schema
    this.state.blockConcurrencyWhile(async () => {
      this.sql.exec(`
        CREATE TABLE IF NOT EXISTS events (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          type TEXT NOT NULL,
          data TEXT,
          created_at INTEGER DEFAULT (unixepoch())
        )
      `)
    })
  }

  async fetch(request: Request): Promise<Response> {
    const url = new URL(request.url)

    if (url.pathname === '/events' && request.method === 'POST') {
      const { type, data } = await request.json()

      // Insert event
      this.sql.exec('INSERT INTO events (type, data) VALUES (?, ?)', type, JSON.stringify(data))

      return Response.json({ success: true })
    }

    if (url.pathname === '/events' && request.method === 'GET') {
      // Query events
      const cursor = this.sql.exec('SELECT * FROM events ORDER BY created_at DESC LIMIT 100')
      const events = [...cursor].map((row) => ({
        id: row.id,
        type: row.type,
        data: JSON.parse(row.data as string),
        created_at: row.created_at,
      }))

      return Response.json({ events })
    }

    return new Response('Not found', { status: 404 })
  }
}
```

### Advanced SQL Queries
```typescript
export class Analytics implements DurableObject {
  private sql: SqlStorage

  constructor(private state: DurableObjectState, private env: Env) {
    this.sql = this.state.storage.sql

    this.state.blockConcurrencyWhile(async () => {
      this.sql.exec(`
        CREATE TABLE IF NOT EXISTS page_views (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          path TEXT NOT NULL,
          user_id TEXT,
          timestamp INTEGER DEFAULT (unixepoch())
        );

        CREATE INDEX IF NOT EXISTS idx_path ON page_views(path);
        CREATE INDEX IF NOT EXISTS idx_timestamp ON page_views(timestamp);
      `)
    })
  }

  async trackPageView(path: string, userId?: string) {
    this.sql.exec('INSERT INTO page_views (path, user_id) VALUES (?, ?)', path, userId || null)
  }

  async getStats(path: string): Promise<any> {
    // Get total views
    const totalCursor = this.sql.exec('SELECT COUNT(*) as count FROM page_views WHERE path = ?', path)
    const total = [...totalCursor][0].count

    // Get views in last 24 hours
    const yesterday = Math.floor(Date.now() / 1000) - 86400
    const recentCursor = this.sql.exec(
      'SELECT COUNT(*) as count FROM page_views WHERE path = ? AND timestamp > ?',
      path,
      yesterday
    )
    const recent = [...recentCursor][0].count

    return { path, totalViews: total, recentViews: recent }
  }
}
```

## WebSocket Server

### Chat Room with WebSockets
```typescript
export class ChatRoom implements DurableObject {
  private sessions: Map<WebSocket, { userId: string; username: string }> = new Map()

  constructor(private state: DurableObjectState, private env: Env) {}

  async fetch(request: Request): Promise<Response> {
    // Upgrade to WebSocket
    const upgradeHeader = request.headers.get('Upgrade')
    if (upgradeHeader !== 'websocket') {
      return new Response('Expected WebSocket', { status: 400 })
    }

    const url = new URL(request.url)
    const userId = url.searchParams.get('userId')
    const username = url.searchParams.get('username')

    if (!userId || !username) {
      return new Response('Missing userId or username', { status: 400 })
    }

    const [client, server] = Object.values(new WebSocketPair())

    // Store session info
    this.sessions.set(server, { userId, username })

    // Accept WebSocket connection
    this.state.acceptWebSocket(server)

    // Broadcast join message
    this.broadcast({
      type: 'user-joined',
      userId,
      username,
      timestamp: Date.now(),
    })

    return new Response(null, {
      status: 101,
      webSocket: client,
    })
  }

  async webSocketMessage(ws: WebSocket, message: string | ArrayBuffer) {
    try {
      const session = this.sessions.get(ws)
      if (!session) return

      const data = JSON.parse(message as string)

      // Broadcast message to all connected clients
      this.broadcast({
        type: 'chat-message',
        userId: session.userId,
        username: session.username,
        message: data.message,
        timestamp: Date.now(),
      })
    } catch (error) {
      console.error('WebSocket message error:', error)
    }
  }

  async webSocketClose(ws: WebSocket, code: number, reason: string) {
    const session = this.sessions.get(ws)
    if (session) {
      this.sessions.delete(ws)

      // Broadcast leave message
      this.broadcast({
        type: 'user-left',
        userId: session.userId,
        username: session.username,
        timestamp: Date.now(),
      })
    }
  }

  private broadcast(message: any) {
    const messageStr = JSON.stringify(message)

    this.state.getWebSockets().forEach((ws) => {
      try {
        ws.send(messageStr)
      } catch (error) {
        console.error('Broadcast error:', error)
      }
    })
  }
}
```

## Alarms API (Background Processing)

### Scheduled Tasks
```typescript
export class Scheduler implements DurableObject {
  constructor(private state: DurableObjectState, private env: Env) {}

  async fetch(request: Request): Promise<Response> {
    const url = new URL(request.url)

    if (url.pathname === '/schedule') {
      // Schedule alarm for 1 hour from now
      const alarmTime = Date.now() + 60 * 60 * 1000
      await this.state.storage.setAlarm(alarmTime)

      return Response.json({ scheduled: alarmTime })
    }

    return new Response('Not found', { status: 404 })
  }

  async alarm() {
    // This runs when the alarm fires
    console.log('Alarm triggered!')

    // Perform background work
    await this.performScheduledTask()

    // Schedule next alarm (e.g., daily at midnight)
    const tomorrow = new Date()
    tomorrow.setDate(tomorrow.getDate() + 1)
    tomorrow.setHours(0, 0, 0, 0)

    await this.state.storage.setAlarm(tomorrow.getTime())
  }

  private async performScheduledTask() {
    // Send emails, cleanup data, etc.
  }
}
```

### Periodic Polling
```typescript
export class PollingAgent implements DurableObject {
  constructor(private state: DurableObjectState, private env: Env) {
    // Start polling when object is created
    this.state.blockConcurrencyWhile(async () => {
      const alarmScheduled = await this.state.storage.get('alarm-scheduled')
      if (!alarmScheduled) {
        await this.scheduleNextPoll()
      }
    })
  }

  async alarm() {
    // Poll external API
    try {
      const response = await fetch('https://api.example.com/status')
      const data = await response.json()

      // Store result in SQLite
      await this.state.storage.put('last-status', data)

      // Process data
      await this.processStatus(data)
    } catch (error) {
      console.error('Polling error:', error)
    }

    // Schedule next poll (every 5 minutes)
    await this.scheduleNextPoll()
  }

  private async scheduleNextPoll() {
    const nextPoll = Date.now() + 5 * 60 * 1000 // 5 minutes
    await this.state.storage.setAlarm(nextPoll)
    await this.state.storage.put('alarm-scheduled', true)
  }

  private async processStatus(status: any) {
    // Handle status updates
  }
}
```

## Rate Limiting

### Per-User Rate Limiter
```typescript
export class RateLimiter implements DurableObject {
  private sql: SqlStorage

  constructor(private state: DurableObjectState, private env: Env) {
    this.sql = this.state.storage.sql

    this.state.blockConcurrencyWhile(async () => {
      this.sql.exec(`
        CREATE TABLE IF NOT EXISTS requests (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          timestamp INTEGER NOT NULL
        )
      `)
    })
  }

  async checkLimit(limit: number, windowSeconds: number): Promise<boolean> {
    const now = Math.floor(Date.now() / 1000)
    const windowStart = now - windowSeconds

    // Clean up old requests
    this.sql.exec('DELETE FROM requests WHERE timestamp < ?', windowStart)

    // Count requests in window
    const cursor = this.sql.exec(
      'SELECT COUNT(*) as count FROM requests WHERE timestamp >= ?',
      windowStart
    )
    const count = [...cursor][0].count as number

    if (count >= limit) {
      return false // Rate limit exceeded
    }

    // Record this request
    this.sql.exec('INSERT INTO requests (timestamp) VALUES (?)', now)

    return true // Within limit
  }

  async fetch(request: Request): Promise<Response> {
    // Check rate limit: 10 requests per 60 seconds
    const allowed = await this.checkLimit(10, 60)

    if (!allowed) {
      return Response.json({ error: 'Rate limit exceeded' }, { status: 429 })
    }

    return Response.json({ success: true })
  }
}
```

## Collaborative Editing

### Document Editor
```typescript
export class Document implements DurableObject {
  private content: string = ''
  private sessions: Map<WebSocket, string> = new Map()

  constructor(private state: DurableObjectState, private env: Env) {
    this.state.blockConcurrencyWhile(async () => {
      const stored = await this.state.storage.get<string>('content')
      this.content = stored || ''
    })
  }

  async fetch(request: Request): Promise<Response> {
    const upgradeHeader = request.headers.get('Upgrade')

    if (upgradeHeader === 'websocket') {
      const url = new URL(request.url)
      const userId = url.searchParams.get('userId')

      if (!userId) {
        return new Response('Missing userId', { status: 400 })
      }

      const [client, server] = Object.values(new WebSocketPair())

      this.sessions.set(server, userId)
      this.state.acceptWebSocket(server)

      // Send current content to new client
      server.send(
        JSON.stringify({
          type: 'init',
          content: this.content,
        })
      )

      return new Response(null, {
        status: 101,
        webSocket: client,
      })
    }

    // HTTP endpoint to get content
    if (request.method === 'GET') {
      return Response.json({ content: this.content })
    }

    return new Response('Not found', { status: 404 })
  }

  async webSocketMessage(ws: WebSocket, message: string | ArrayBuffer) {
    try {
      const data = JSON.parse(message as string)
      const userId = this.sessions.get(ws)

      if (data.type === 'update') {
        // Apply operational transformation or CRDT logic here
        this.content = data.content

        // Persist to storage
        await this.state.storage.put('content', this.content)

        // Broadcast to all clients except sender
        this.broadcast(
          {
            type: 'update',
            content: this.content,
            userId,
          },
          ws
        )
      }
    } catch (error) {
      console.error('WebSocket message error:', error)
    }
  }

  async webSocketClose(ws: WebSocket) {
    this.sessions.delete(ws)
  }

  private broadcast(message: any, exclude?: WebSocket) {
    const messageStr = JSON.stringify(message)

    this.state.getWebSockets().forEach((ws) => {
      if (ws !== exclude) {
        try {
          ws.send(messageStr)
        } catch (error) {
          console.error('Broadcast error:', error)
        }
      }
    })
  }
}
```

## Best Practices

1. **Unique IDs** - Use `idFromName()` for deterministic IDs, `newUniqueId()` for random
2. **Initialization** - Use `blockConcurrencyWhile()` for async initialization
3. **Storage Patterns** - Use SQLite for complex queries, KV storage for simple data
4. **WebSocket Cleanup** - Always handle `webSocketClose()` to remove sessions
5. **Alarms** - Use for background tasks, periodic polling, scheduled work
6. **Rate Limiting** - Implement per-user or per-IP rate limits
7. **Error Handling** - Wrap WebSocket message handlers in try-catch
8. **Broadcast Efficiently** - Use `getWebSockets()` for mass broadcasting
9. **Hibernation** - Objects automatically hibernate when idle (free tier)
10. **Session Affinity** - WebSocket connections stick to same DO instance
11. **Strong Consistency** - Leverage guaranteed single instance per ID
12. **SQL Indexes** - Create indexes for frequently queried columns
13. **Memory Management** - Clean up old data to avoid memory leaks
14. **Migrations** - Version your DO classes with migrations
15. **Testing** - Use Miniflare for local DO testing

## Error Handling

```typescript
export class SafeDurableObject implements DurableObject {
  constructor(private state: DurableObjectState, private env: Env) {}

  async fetch(request: Request): Promise<Response> {
    try {
      // Your logic here
      return Response.json({ success: true })
    } catch (error) {
      console.error('Durable Object error:', error)

      return Response.json(
        {
          error: 'Internal error',
          message: error instanceof Error ? error.message : 'Unknown error',
        },
        { status: 500 }
      )
    }
  }

  async webSocketMessage(ws: WebSocket, message: string | ArrayBuffer) {
    try {
      const data = JSON.parse(message as string)
      // Handle message
    } catch (error) {
      console.error('WebSocket error:', error)

      ws.send(
        JSON.stringify({
          type: 'error',
          message: error instanceof Error ? error.message : 'Unknown error',
        })
      )
    }
  }

  async alarm() {
    try {
      // Scheduled task
    } catch (error) {
      console.error('Alarm error:', error)

      // Reschedule on error
      await this.state.storage.setAlarm(Date.now() + 60 * 1000)
    }
  }
}
```

