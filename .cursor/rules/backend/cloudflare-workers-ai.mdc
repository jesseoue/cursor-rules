## Batch Inference API (New - 2025)

### Batch Text Generation
```typescript
async function batchGenerate(ai: Ai, prompts: string[]) {
  const batchRequests = prompts.map((prompt) => ({
    messages: [{ role: 'user', content: prompt }],
    max_tokens: 256,
  }))

  // Process batch - fulfilled as fast as possible
  const responses = await ai.runBatch('@cf/meta/llama-3.3-70b-instruct-fp8-fast', batchRequests)

  return responses.map((r: any) => r.response)
}
```

### Batch Embeddings
```typescript
async function batchEmbeddings(ai: Ai, texts: string[]) {
  // Batch embedding generation for large datasets
  const BATCH_SIZE = 100

  const batches = []
  for (let i = 0; i < texts.length; i += BATCH_SIZE) {
    batches.push(texts.slice(i, i + BATCH_SIZE))
  }

  const allEmbeddings = []
  for (const batch of batches) {
    const response = await ai.run('@cf/baai/bge-base-en-v1.5', {
      text: batch,
    })
    allEmbeddings.push(...response.data)
  }

  return allEmbeddings
}
```

