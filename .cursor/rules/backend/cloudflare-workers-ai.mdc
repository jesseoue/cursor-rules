## RAG (Retrieval-Augmented Generation)

### Complete RAG Pipeline
```typescript
export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const ai = new Ai(env.AI)
    const { question } = await request.json()

    // 1. Generate query embedding
    const queryEmbedding = await ai.run('@cf/baai/bge-base-en-v1.5', {
      text: [question],
    })

    // 2. Search vector database (e.g., Vectorize)
    const relevant = await searchVectorDB(env.VECTORIZE, queryEmbedding.data[0])

    // 3. Build context from relevant documents
    const context = relevant.map((doc: any) => doc.text).join('\n\n')

    // 4. Generate answer with context
    const response = await ai.run('@cf/meta/llama-3.3-70b-instruct-fp8-fast', {
      messages: [
        {
          role: 'system',
          content: `Answer the question based on the following context:\n\n${context}`,
        },
        { role: 'user', content: question },
      ],
    })

    return Response.json({
      question,
      answer: response.response,
      sources: relevant,
    })
  },
}

