## Sending Emails

### Send Single Email
```typescript
import { resend } from '@/lib/resend'
import { WelcomeEmail } from '@/emails/welcome'

export async function sendWelcomeEmail(
  to: string,
  name: string,
  verificationUrl: string
) {
  try {
    const { data, error } = await resend.emails.send({
      from: 'Acme <onboarding@resend.dev>',
      to: [to],
      subject: 'Welcome to Acme!',
      react: WelcomeEmail({ name, verificationUrl }),
    })

    if (error) {
      console.error('Failed to send email:', error)
      throw new Error('Failed to send email')
    }

    return data
  } catch (error) {
    console.error('Error sending email:', error)
    throw error
  }
}
```

### Send with Attachments
```typescript
export async function sendInvoiceEmail(
  to: string,
  invoicePdf: Buffer
) {
  const { data, error } = await resend.emails.send({
    from: 'Billing <billing@yourdomain.com>',
    to: [to],
    subject: 'Your Invoice',
    react: InvoiceEmail(),
    attachments: [
      {
        filename: 'invoice.pdf',
        content: invoicePdf,
      },
    ],
  })

  if (error) throw new Error(error.message)
  return data
}
```

### Batch Sending
```typescript
export async function sendBatchEmails(users: User[]) {
  const emails = users.map((user) => ({
    from: 'Newsletter <newsletter@yourdomain.com>',
    to: [user.email],
    subject: 'Monthly Update',
    react: NewsletterEmail({ name: user.name }),
  }))

  const { data, error } = await resend.batch.send(emails)

  if (error) throw new Error(error.message)
  return data
}
```

## Server Actions (Next.js)

### Contact Form
```typescript
// app/actions/contact.ts
'use server'

import { resend } from '@/lib/resend'
import { ContactEmail } from '@/emails/contact'
import { z } from 'zod'

const ContactSchema = z.object({
  name: z.string().min(1),
  email: z.string().email(),
  message: z.string().min(10),
})

export async function sendContactEmail(formData: FormData) {
  const validated = ContactSchema.parse({
    name: formData.get('name'),
    email: formData.get('email'),
    message: formData.get('message'),
  })

  const { error } = await resend.emails.send({
    from: 'Contact Form <contact@yourdomain.com>',
    to: ['support@yourdomain.com'],
    replyTo: validated.email,
    subject: `New message from ${validated.name}`,
    react: ContactEmail(validated),
  })

  if (error) {
    throw new Error('Failed to send message')
  }

  return { success: true }
}
```

## Webhooks

### Handle Email Events
```typescript
// app/api/webhooks/resend/route.ts
import { NextRequest, NextResponse } from 'next/server'

export async function POST(request: NextRequest) {
  const payload = await request.json()

  switch (payload.type) {
    case 'email.sent':
      console.log(`Email sent: ${payload.data.email_id}`)
      break
    case 'email.delivered':
      console.log(`Email delivered: ${payload.data.email_id}`)
      break
    case 'email.opened':
      console.log(`Email opened: ${payload.data.email_id}`)
      break
    case 'email.clicked':
      console.log(`Link clicked: ${payload.data.click.link}`)
      break
    case 'email.bounced':
      console.log(`Email bounced: ${payload.data.email_id}`)
      // Handle bounce - maybe disable email sending
      break
    case 'email.complained':
      console.log(`Spam complaint: ${payload.data.email_id}`)
      // Handle complaint - unsubscribe user
      break
  }

  return NextResponse.json({ received: true })
}
```

## Best Practices

1. **Use React Email** - Design emails with components, not HTML strings
2. **Verify domain** - Set up SPF, DKIM, DMARC for better deliverability
3. **Handle errors** - Always check for errors and log them
4. **Batch for newsletters** - Use batch.send for multiple recipients
5. **Include preview text** - Use Preview component for inbox preview
6. **Unsubscribe links** - Include unsubscribe option in marketing emails
7. **Test emails** - Send to yourself first to verify rendering
8. **Track events** - Use webhooks for delivery status
9. **Rate limiting** - Respect Resend's rate limits
10. **Transactional vs marketing** - Use different senders
11. **Reply-to address** - Set appropriate reply-to for responses
12. **Mobile-friendly** - Design responsive email templates
13. **Plain text fallback** - Include text version for accessibility
14. **Personalization** - Use recipient data in templates
15. **Error handling** - Gracefully handle send failures
