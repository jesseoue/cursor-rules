## HTTP Server (Bun.serve)

### Basic Server
```typescript
import { serve } from 'bun'

const server = serve({
  port: 3000,
  fetch(req) {
    const url = new URL(req.url)

    if (url.pathname === '/') {
      return new Response('Home page')
    }

    if (url.pathname === '/api/users') {
      return Response.json({ users: ['Alice', 'Bob'] })
    }

    return new Response('Not found', { status: 404 })
  },
})

console.log(`Server running on ${server.url}`)
```

### Built-in Routing (v1.3+)
```typescript
import { serve } from 'bun'

serve({
  port: 3000,

  // Built-in routing
  routes: {
    '/': (req) => new Response('Home'),

    '/api/users': (req) => {
      return Response.json({ users: [] })
    },

    '/api/users/:id': (req, { params }) => {
      return Response.json({ id: params.id })
    },

    // Static files with automatic ETag
    '/public/*': {
      static: './public',
    },
  },
})
```

### Cookie Support (Built-in v1.3+)
```typescript
import { serve } from 'bun'

serve({
  port: 3000,
  fetch(req) {
    // Read cookies (Map-like API)
    const sessionId = req.cookies.get('sessionId')

    const response = new Response('Welcome!')

    // Set cookies (automatically adds Set-Cookie header)
    response.cookies.set('sessionId', 'abc123', {
      httpOnly: true,
      secure: true,
      maxAge: 3600,
      sameSite: 'strict',
    })

    return response
  },
})
```

### WebSocket with Compression (permessage-deflate)
```typescript
import { serve } from 'bun'

serve({
  port: 3000,
  fetch(req, server) {
    if (server.upgrade(req)) {
      return // WebSocket upgrade
    }
    return new Response('HTTP response')
  },

  websocket: {
    // permessage-deflate compression (60-80% size reduction)
    perMessageDeflate: true,

    message(ws, message) {
      console.log('Received:', message)
      ws.send(`Echo: ${message}`)
    },

    open(ws) {
      console.log('Client connected')
      ws.subscribe('chat-room')
    },

    close(ws) {
      console.log('Client disconnected')
    },
  },
})
```

## File System (Bun.file)

### Reading Files
```typescript
// Read file as text
const file = Bun.file('data.txt')
const text = await file.text()

// Read as JSON
const config = await Bun.file('config.json').json()

// Read as ArrayBuffer
const buffer = await Bun.file('image.png').arrayBuffer()

// Stream large files
const file = Bun.file('large.csv')
const stream = file.stream()

// Check if file exists
const exists = await Bun.file('data.txt').exists()

// Get file size
const size = Bun.file('data.txt').size
```

### Writing Files
```typescript
// Write text
await Bun.write('output.txt', 'Hello, Bun!')

// Write JSON
await Bun.write('data.json', JSON.stringify({ name: 'Alice' }))

// Write from Response
const response = await fetch('https://example.com/image.png')
await Bun.write('image.png', response)

// Write with Bun.file()
const file = Bun.file('output.txt')
await Bun.write(file, 'Content')

// Append to file
await Bun.write('log.txt', 'New entry\n', { flags: 'a' })
```

### File Operations
```typescript
// Delete file (v1.3+)
await Bun.file('temp.txt').delete()
// or
await Bun.file('temp.txt').unlink()

// Get file metadata
const stats = await Bun.file('data.txt').stat()
console.log(stats.size, stats.mtime)
```

## Database (Bun.SQL - v1.3+)

### SQLite
```typescript
import { Database } from 'bun:sqlite'

const db = new Database('mydb.sqlite')

// Create table
db.run(`
  CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY,
    name TEXT,
    email TEXT UNIQUE
  )
`)

// Insert
const insert = db.prepare('INSERT INTO users (name, email) VALUES (?, ?)')
insert.run('Alice', 'alice@example.com')

// Query
const query = db.prepare('SELECT * FROM users WHERE name = ?')
const user = query.get('Alice')

// Query all
const users = db.prepare('SELECT * FROM users').all()

// Transaction
db.transaction(() => {
  insert.run('Bob', 'bob@example.com')
  insert.run('Charlie', 'charlie@example.com')
})()
```

### PostgreSQL/MySQL (Bun.SQL API - v1.3+)
```typescript
import { SQL } from 'bun'

// PostgreSQL
const db = await SQL.connect('postgresql://user:pass@localhost/db')

// MySQL
const db = await SQL.connect('mysql://user:pass@localhost/db')

// Query
const users = await db.query('SELECT * FROM users WHERE active = $1', [true])

// Insert
await db.query(
  'INSERT INTO users (name, email) VALUES ($1, $2)',
  ['Alice', 'alice@example.com']
)

// Prepared statements
const stmt = await db.prepare('SELECT * FROM users WHERE id = $1')
const user = await stmt.get(123)
```

## Password Hashing (Bun.password)

```typescript
// Hash password (uses Argon2 by default)
const hash = await Bun.password.hash('mypassword123')

// Verify password
const isValid = await Bun.password.verify('mypassword123', hash)

// Custom options
const hash = await Bun.password.hash('mypassword123', {
  algorithm: 'argon2id', // or 'bcrypt'
  memoryCost: 19456,
  timeCost: 2,
})
```

## Test Runner (Built-in)

### Basic Testing
```typescript
// math.test.ts
import { expect, test, describe } from 'bun:test'
import { add, multiply } from './math'

describe('Math functions', () => {
  test('add two numbers', () => {
    expect(add(2, 3)).toBe(5)
  })

  test('multiply two numbers', () => {
    expect(multiply(2, 3)).toBe(6)
  })
})
```

```bash
# Run tests
bun test

# Watch mode
bun test --watch

# Run specific file
bun test math.test.ts

# Coverage
bun test --coverage
```

### Async Testing
```typescript
import { expect, test } from 'bun:test'

test('async operation', async () => {
  const result = await fetchData()
  expect(result).toBeDefined()
})

test('promise resolves', async () => {
  await expect(Promise.resolve('data')).resolves.toBe('data')
})

test('promise rejects', async () => {
  await expect(Promise.reject('error')).rejects.toBe('error')
})
```

### Mocking
```typescript
import { mock, spyOn } from 'bun:test'

test('mock function', () => {
  const mockFn = mock((x: number) => x * 2)

  mockFn(5)

  expect(mockFn).toHaveBeenCalledWith(5)
  expect(mockFn).toHaveBeenCalledTimes(1)
})

test('spy on object method', () => {
  const obj = { getValue: () => 42 }
  const spy = spyOn(obj, 'getValue')

  obj.getValue()

  expect(spy).toHaveBeenCalled()
})
```

## Bundler

### Build for Production
```bash
# Bundle for browser
bun build ./index.ts --outdir ./dist

# Minify
bun build ./index.ts --outfile ./dist/app.js --minify

# Multiple entry points
bun build ./src/index.ts ./src/worker.ts --outdir ./dist

# Splitting
bun build ./index.ts --outdir ./dist --splitting

# Target
bun build ./index.ts --outdir ./dist --target browser
bun build ./index.ts --outdir ./dist --target node
```

### Configuration
```typescript
// build.ts
await Bun.build({
  entrypoints: ['./src/index.ts'],
  outdir: './dist',
  target: 'browser',
  minify: true,
  splitting: true,
  sourcemap: 'external',
})
```

